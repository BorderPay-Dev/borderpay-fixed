# BorderPay Africa - Environment Variables
# Copy this file to .env (frontend) and set Supabase Edge Function secrets separately.

# Frontend (Vite)
VITE_SUPABASE_URL=https://orwrcpwsffjlvzuraxjc.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=orwrcpwsffjlvzuraxjc

# Supabase Edge Function secrets (set with: supabase secrets set ...)
SUPABASE_URL=https://orwrcpwsffjlvzuraxjc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SEND_EMAIL_INTERNAL_TOKEN=replace-with-strong-random-token
RESEND_API_KEY=re_xxx
BORDERPAY_FROM_EMAIL=BorderPay Africa <noreply@app.borderpayafrica.com>
BORDERPAY_APP_URL=https://app.borderpayafrica.com

# Bridge
BRIDGE_API_KEY=bridge_live_or_sandbox_key
BRIDGE_BASE_URL=https://api.bridge.xyz
BRIDGE_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----"
BRIDGE_TRANSFERS_ENABLED=false
BRIDGE_ONBOARDING_ENABLED=true

# Flutterwave (African rails adapter)
FLW_SECRET_KEY=flw_secret_key
FLW_BASE_URL=https://api.flutterwave.com
FLW_HTTP_TIMEOUT_MS=15000
FLW_RECEIVE_ENABLED=false
FLW_PAYOUT_ENABLED=false
FLW_WEBHOOK_SECRET_HASH=
FLW_WEBHOOK_SECRET=
FLW_WEBHOOK_REPLAY_WINDOW_MINUTES=1440

# Static egress policy for money movement
# Set READY=true only after allowlisting your outbound IP(s) in Flutterwave.
FLW_STATIC_IP_REQUIRED=true
FLW_STATIC_IP_READY=false

# Auth hardening
TOTP_ENCRYPTION_KEY=base64_32_byte_key
WEBAUTHN_RP_ID=app.borderpayafrica.com
WEBAUTHN_ORIGIN=https://app.borderpayafrica.com

# Optional signup CAPTCHA (Turnstile-compatible)
SIGNUP_CAPTCHA_SECRET=
SIGNUP_CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Queue worker DB settings (not env vars; set once per DB):
# alter database postgres set app.process_pending_events_url =
#   'https://<project-ref>.supabase.co/functions/v1/process-pending-events';
# alter database postgres set app.process_pending_events_jwt = '<service-role-jwt>';
